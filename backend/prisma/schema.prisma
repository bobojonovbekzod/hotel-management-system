// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kompaniyalar (SaaS mijozlari)
model Company {
  id                 Int       @id @default(autoincrement())
  name               String
  logoUrl            String?
  subscriptionEndsAt DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users                 User[]
  branches              Branch[]
  rooms                 Room[]
  bookings              Booking[]
  shifts                Shift[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  attendance            Attendance[]
  devices               Device[]
  guests                Guest[]
  payrollTransactions   PayrollTransaction[]
  cleaningTasks         CleaningTask[]
  roomCategories        RoomCategory[]
  inventoryCategories   InventoryCategory[]
  inventoryProducts     InventoryProduct[]
  inventoryBatches      InventoryBatch[]
  inventoryRequests     InventoryRequest[]
  inventoryTransactions InventoryTransaction[]
  tasks                 Task[]
  leads                 Lead[]
  leadCallLogs          LeadCallLog[]
  candidates            Candidate[]

  @@map("companies")
}

// Xona turlari (Kompaniya darajasida)
model RoomCategory {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@map("room_categories")
}

// Filialar
model Branch {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  address   String?
  phone         String?
  isActive      Boolean  @default(true)
  adminKpiTiers Json?
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company                @relation(fields: [companyId], references: [id])
  users                 User[]
  rooms                 Room[]
  bookings              Booking[]
  shifts                Shift[]
  expenses              Expense[]
  attendance            Attendance[]
  devices               Device[]
  payrollTransactions   PayrollTransaction[]
  cleaningTasks         CleaningTask[]
  inventoryBatches      InventoryBatch[]
  inventoryRequests     InventoryRequest[]
  inventoryTransactions InventoryTransaction[]
  tasks                 Task[]
  leads                 Lead[]
  candidates            Candidate[]

  @@map("branches")
}

// Foydalanuvchilar (Rollar bilan)
model User {
  id               Int        @id @default(autoincrement())
  companyId        Int? // Null bo'lishi mumkin (Super Admin uchun)
  branchId         Int?
  name             String
  username         String     @unique
  password         String
  role             Role
  phone            String?
  salary           Float?     @default(0)
  salaryType       SalaryType @default(static)
  kpiPercentage    Float?     @default(0) // Kassadan tushadigan ulush foizi (masalan, 5%)
  isActive         Boolean    @default(true)
  birthDate        DateTime?
  gender           String?
  telegram         String?
  photoUrl         String?
  isFaceRegistered Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  company                   Company?               @relation(fields: [companyId], references: [id])
  branch                    Branch?                @relation(fields: [branchId], references: [id])
  bookings                  Booking[]
  shifts                    Shift[]
  expenses                  Expense[]
  attendance                Attendance[]
  payrollTransactions       PayrollTransaction[]   @relation("UserPayroll")
  givenTransactions         PayrollTransaction[]   @relation("AdminPayroll")
  notifications             Notification[]
  cleaningTasks             CleaningTask[]
  resolvedShiftIssues       Shift[]                @relation("ResolvedShiftIssues")
  inventoryRequestsMade     InventoryRequest[]     @relation("RequestInitiator")
  inventoryRequestsApproved InventoryRequest[]     @relation("RequestApprover")
  inventoryTransactions     InventoryTransaction[] @relation("TransactionAdmin")
  tasksCreated              Task[]                 @relation("TaskCreator")
  tasksAssigned             Task[]                 @relation("TaskAssignee")
  assignedLeads             Lead[]                 @relation("AssignedLeads")
  operatorCallLogs          LeadCallLog[]          @relation("OperatorCallLogs")

  @@map("users")
}

enum SalaryType {
  static
  per_shift
  per_room
}

enum Role {
  superadmin
  owner
  director
  supervisor
  admin
  cleaner
  operator
}

// Xonalar
model Room {
  id            Int        @id @default(autoincrement())
  companyId     Int
  branchId      Int
  roomNumber    String
  roomType      String     @default("standard_1")
  floor         Int        @default(1)
  capacity      Int        @default(2)
  pricePerNight Float
  status        RoomStatus @default(available)
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  bookings      Booking[]
  cleaningTasks CleaningTask[]

  @@unique([branchId, roomNumber])
  @@map("rooms")
}

enum RoomStatus {
  available
  occupied
  cleaning
  maintenance
}

// Mehmonlar
model Guest {
  id             Int      @id @default(autoincrement())
  companyId      Int
  firstName      String
  lastName       String
  phone          String?
  passportNumber String?
  nationality    String   @default("UZ")
  createdAt      DateTime @default(now())

  company         Company        @relation(fields: [companyId], references: [id])
  primaryBookings Booking[]      @relation("PrimaryGuest")
  bookingGuests   BookingGuest[]

  @@map("guests")
}

// Band qilishlar (Booking / Check-in)
model Booking {
  id               Int            @id @default(autoincrement())
  companyId        Int
  branchId         Int
  roomId           Int
  primaryGuestId   Int
  adminId          Int
  shiftId          Int?
  checkIn          DateTime
  checkOutExpected DateTime
  checkOutActual   DateTime?
  totalPrice       Float
  monthlyFee       Float?
  paidAmount       Float          @default(0)
  paymentMethod    PaymentMethod?
  status           BookingStatus  @default(active)
  bookingType      String         @default("daily")
  shiftType        ShiftType?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company          Company        @relation(fields: [companyId], references: [id])
  branch           Branch         @relation(fields: [branchId], references: [id])
  room             Room           @relation(fields: [roomId], references: [id])
  primaryGuest     Guest          @relation("PrimaryGuest", fields: [primaryGuestId], references: [id])
  admin            User           @relation(fields: [adminId], references: [id])
  shift            Shift?         @relation(fields: [shiftId], references: [id])
  additionalGuests BookingGuest[]
  payments         Payment[]

  @@map("bookings")
}

model BookingGuest {
  id        Int @id @default(autoincrement())
  bookingId Int
  guestId   Int
  relation  String?

  booking Booking @relation(fields: [bookingId], references: [id])
  guest   Guest   @relation(fields: [guestId], references: [id])

  @@map("booking_guests")
}

enum PaymentMethod {
  cash
  qrcode
  terminal
  mixed
  transfer
}

model Payment {
  id          Int           @id @default(autoincrement())
  bookingId   Int
  shiftId     Int?
  amount      Float
  method      PaymentMethod
  type        String        @default("room") // room, penalty, advance
  description String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  @@map("payments")
}

enum BookingStatus {
  active
  checked_out
  cancelled
  reserved
}

enum ShiftType {
  morning
  night
  daily
}

// Smenalar
model Shift {
  id                Int         @id @default(autoincrement())
  companyId         Int
  branchId          Int
  adminId           Int
  shiftType         ShiftType
  startTime         DateTime
  endTime           DateTime?
  totalIncome       Float       @default(0)
  totalBookings     Int         @default(0)
  totalPenalties    Float       @default(0)
  startPhotoUrl     String?
  notes             String?
  hasIssue          Boolean     @default(false)
  issueDescription  String?
  isIssueResolved   Boolean     @default(true)
  issueResolvedById Int?
  status            ShiftStatus @default(active)
  createdAt         DateTime    @default(now())

  company         Company   @relation(fields: [companyId], references: [id])
  issueResolvedBy User?     @relation("ResolvedShiftIssues", fields: [issueResolvedById], references: [id])
  branch          Branch    @relation(fields: [branchId], references: [id])
  admin           User      @relation(fields: [adminId], references: [id])
  bookings        Booking[]
  expenses        Expense[]
  payments        Payment[]

  @@map("shifts")
}

enum ShiftStatus {
  active
  closed
}

// Xarajatlar
model Expense {
  id          Int      @id @default(autoincrement())
  companyId   Int
  branchId    Int
  adminId     Int
  shiftId     Int?
  categoryId  Int
  amount      Float
  description String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id])
  branch   Branch          @relation(fields: [branchId], references: [id])
  admin    User            @relation(fields: [adminId], references: [id])
  shift    Shift?          @relation(fields: [shiftId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@map("expenses")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model CleaningTask {
  id          Int      @id @default(autoincrement())
  companyId   Int
  branchId    Int
  roomId      Int?
  taskType    String   @default("room") // room, corridor, street
  cleanerId   Int
  status      String   @default("pending") // pending, completed
  beforeImage String?
  afterImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  branch      Branch   @relation(fields: [branchId], references: [id])
  room        Room?    @relation(fields: [roomId], references: [id])
  cleaner     User     @relation(fields: [cleanerId], references: [id])

  @@map("cleaning_tasks")
}

model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  expenses Expense[]

  @@map("expense_categories")
}

// Xodimlar Ish Haqi va Jarimalari (Payroll)
model PayrollTransaction {
  id          Int             @id @default(autoincrement())
  companyId   Int
  branchId    Int
  userId      Int
  adminId     Int
  type        TransactionType
  amount      Float
  description String?
  date        DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  user    User    @relation("UserPayroll", fields: [userId], references: [id])
  admin   User    @relation("AdminPayroll", fields: [adminId], references: [id])

  @@map("payroll_transactions")
}

enum TransactionType {
  advance
  penalty
  bonus
  salary_payment
  shift_earnings
}

// Xodimlar davomati (Face ID uchun)
model Attendance {
  id        Int       @id @default(autoincrement())
  companyId Int
  userId        Int
  branchId      Int
  checkIn       DateTime?
  checkOut      DateTime?
  checkInPhoto  String?
  checkOutPhoto String?
  workDate      DateTime
  notes         String?
  createdAt     DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@map("attendance")
}

// Face ID qurilmalari
model Device {
  id         Int      @id @default(autoincrement())
  companyId  Int
  branchId   Int
  name       String
  ipAddress  String
  port       Int      @default(80)
  username   String
  password   String
  deviceType String   @default("hikvision")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@map("devices")
}

// --- OMBORXONA (INVENTORY) TIZIMI ---

// Kategoriya (Masalan: Xo'jalik mollari, Choyshablar)
model InventoryCategory {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  createdAt DateTime @default(now())

  company  Company            @relation(fields: [companyId], references: [id])
  products InventoryProduct[]

  @@map("inventory_categories")
}

// Mahsulot (Masalan: Oq sochiq 50x100, Sovun)
model InventoryProduct {
  id              Int      @id @default(autoincrement())
  companyId       Int
  categoryId      Int
  name            String
  measurementUnit String   @default("dona") // dona, kg, litr
  hasLifespan     Boolean  @default(false)
  lifespanDays    Int? // Necha kun xizmat qiladi
  createdAt       DateTime @default(now())

  company      Company                @relation(fields: [companyId], references: [id])
  category     InventoryCategory      @relation(fields: [categoryId], references: [id])
  batches      InventoryBatch[]
  requests     InventoryRequest[]
  transactions InventoryTransaction[]

  @@map("inventory_products")
}

// Mahsulot partiyasi (Kirim bo'lganida yoki filialga o'tganida)
model InventoryBatch {
  id             Int       @id @default(autoincrement())
  companyId      Int
  branchId       Int? // Null bo'lsa Bosh Omborda
  productId      Int
  quantity       Float
  purchasePrice  Float?
  purchaseDate   DateTime  @default(now())
  expirationDate DateTime? // hasLifespan=true bo'lsa hisoblanadi
  status         String    @default("active") // active, expired, exhausted

  company Company          @relation(fields: [companyId], references: [id])
  branch  Branch?          @relation(fields: [branchId], references: [id])
  product InventoryProduct @relation(fields: [productId], references: [id])

  @@map("inventory_batches")
}

// Filialdan Bosh omborga (Ownerga) so'rov
model InventoryRequest {
  id                Int      @id @default(autoincrement())
  companyId         Int
  branchId          Int
  productId         Int
  requestedQuantity Float
  status            String   @default("pending") // pending, approved, rejected
  requestedById     Int
  approvedById      Int?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  branch      Branch           @relation(fields: [branchId], references: [id])
  product     InventoryProduct @relation(fields: [productId], references: [id])
  requestedBy User             @relation("RequestInitiator", fields: [requestedById], references: [id])
  approvedBy  User?            @relation("RequestApprover", fields: [approvedById], references: [id])

  @@map("inventory_requests")
}

// Tarix (Kirim, Chiqim, Filialga berish)
model InventoryTransaction {
  id        Int      @id @default(autoincrement())
  companyId Int
  branchId  Int? // Qaysi filialga aloqador (Chiqim/So'rov bo'lsa)
  productId Int
  type      String // IN (Kirim), OUT (Brak/Chiqim), TRANSFER (Filialga)
  quantity  Float
  adminId   Int
  notes     String?
  createdAt DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id])
  branch  Branch?          @relation(fields: [branchId], references: [id])
  product InventoryProduct @relation(fields: [productId], references: [id])
  admin   User             @relation("TransactionAdmin", fields: [adminId], references: [id])

  @@map("inventory_transactions")
}

// Vazifalar Boshqaruvi (Jira)
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          Int          @id @default(autoincrement())
  companyId   Int
  branchId    Int
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  creatorId   Int
  assigneeId  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company  Company @relation(fields: [companyId], references: [id])
  branch   Branch  @relation(fields: [branchId], references: [id])
  creator  User    @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee User    @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@map("tasks")
}

// --- CALL CENTER & LEADS (LIDLAR VA CRM) ---
model Lead {
  id           Int           @id @default(autoincrement())
  companyId    Int
  branchId     Int?
  name         String
  phone        String
  region       String?
  tag          String?
  source       String?       @default("Instagram")
  roomType     String?
  checkIn      DateTime?
  checkOut     DateTime?
  notes        String?       @db.Text
  revenue      Float         @default(0)
  stage        String        @default("new") // new, no_answer, info_given, booked, sold, deferred, repeat_sale, rejected, not_our_cat, expired
  taskStatus   String?       @default("none")
  taskText     String?
  assignedToId Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  branch     Branch?       @relation(fields: [branchId], references: [id])
  assignedTo User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  callLogs   LeadCallLog[]

  @@map("leads")
}

model LeadCallLog {
  id         Int      @id @default(autoincrement())
  companyId  Int
  leadId     Int?
  operatorId Int?
  phone      String
  direction  String   @default("incoming") // incoming, outgoing
  duration   Int      @default(0) // seconds
  status     String?
  audioUrl   String?
  notes      String?
  createdAt  DateTime @default(now())

  company  Company @relation(fields: [companyId], references: [id])
  lead     Lead?   @relation(fields: [leadId], references: [id])
  operator User?   @relation("OperatorCallLogs", fields: [operatorId], references: [id])

  @@map("lead_call_logs")
}

// --- HR & JOB CANDIDATES (VAKANSIYA NOMZODLARI) ---
model Candidate {
  id                Int      @id @default(autoincrement())
  companyId         Int      @default(1)
  branchId          Int?
  position          String   @default("Admin") // 'Admin' or 'Tozalik xodimi'
  name              String
  phone             String
  experience        String   @db.Text
  yearsOfExperience String
  score             Int      // Score out of 10
  totalQuestions    Int      @default(10)
  status            String   @default("new") // 'new', 'interviewed', 'hired', 'rejected'
  answersJson       String?  @db.Text
  telegramUserId    BigInt?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company  @relation(fields: [companyId], references: [id])
  branch            Branch?  @relation(fields: [branchId], references: [id])

  @@map("candidates")
}

